# Copie para .env e preencha. NUNCA versione o .env.
DEBUG=true
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (produção). Sem DATABASE_URL usa SQLite local (somente desenvolvimento).
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# CSRF_TRUSTED_ORIGINS=https://seu-app.onrender.com

# E-mail do link de login (Gmail com "senha de app"; em DEBUG o link aparece no terminal)
# EMAIL_HOST_USER=conta.do.projeto@gmail.com
# EMAIL_HOST_PASSWORD=senha-de-app-de-16-caracteres
# DEFAULT_FROM_EMAIL=Trilha USP <conta.do.projeto@gmail.com>

ALLOWED_EMAIL_DOMAINS=usp.br
RESUMOS_PUBLICOS=false
