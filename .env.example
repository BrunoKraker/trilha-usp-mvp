# Copie para .env e preencha. NUNCA versione o .env.
# Local: DEBUG=true (gera uma chave de desenvolvimento). Em produção: DEBUG=false e SECRET_KEY própria (32+ caracteres).
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Caminho do painel administrativo (em produção use algo não óbvio, ex.: gestao-x7k2p9/)
# ADMIN_URL=admin/
# PostgreSQL (produção). Sem DATABASE_URL usa SQLite local (somente desenvolvimento).
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# CSRF_TRUSTED_ORIGINS=https://seu-app.onrender.com

# E-mail do link de login. Em DEBUG o link aparece no terminal.
# No Render GRÁTIS o SMTP é bloqueado: use a API do Brevo (HTTPS).
# EMAIL_BACKEND=contas.email_backends.BrevoEmailBackend
# BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=Trilha USP <remetente-verificado-no-brevo@exemplo.com>

ALLOWED_EMAIL_DOMAINS=usp.br
RESUMOS_PUBLICOS=false
# Quantos proxies confiáveis estão na frente do app (veja o README, seção "IP do cliente")
# TRUSTED_PROXY_HOPS=1
# CONTATO_NOTIFICAR=seu-email@exemplo.com
# SENTRY_DSN=
